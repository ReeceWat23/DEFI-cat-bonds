# Foundry build artifacts
cache/
out/

# Foundry dependencies — install locally with: forge install
# (not committed; use git submodules or forge install after cloning)
/lib/

# Claude Code session data (local only)
.claude/

# Deployment broadcast logs (keep folder; ignore local/anvil runs)
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Environment variables and secrets
.env
.env.*
!.env.example

# Private keys and keystores
*.pem
*.key
keystore/

# Coverage reports
coverage/
lcov.info
coverage.json

# Python
__pycache__/
*.pyc
.pytest_cache/

# Monitor service runtime data (api/monitor/) — accumulated at runtime,
# never committed. Tests use a temp DB via monkeypatch, not this file.
api/monitor/data/

# Local scratch/reference material (v2 homepage port source) — not app code
/files 1/
/rhodex-home-nextjs.zip
/rhodexv2full/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~
